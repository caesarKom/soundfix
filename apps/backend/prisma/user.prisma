model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name  String     @unique
  password  String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  sessions Session[]
  profile  Profile?
  uploadedMusic Music[]
  playlists Playlist[]
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  deviceInfo String? // Np. "iPhone - iOS", "Chrome - Windows"
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  SEX
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  firstName String?
  lastName  String?
  birthDay  String?
  bio       String?
  avatar    String?
  gender    Gender  @default(SEX)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
