{
  "name": "soundfix-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:admin": "pnpm --filter admin dev",

    "build": "pnpm -r build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:admin": "pnpm --filter admin build",

    "db:generate": "pnpm --filter backend prisma:generate",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:studio": "pnpm --filter backend prisma:studio",
    
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    
    "clean": "pnpm -r exec rm -rf node_modules dist build .next",
    "clean:all": "rm -rf node_modules pnpm-lock.yaml && pnpm -r exec rm -rf node_modules dist build .next"
    
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18.18.0"
  }
}